[Unit]
Description=Periodic trigger for Log Analysis & Incident Detection
Requires=log-analyzer.service

[Timer]
Unit=log-analyzer.service
# Run 1 minute after boot, then every 5 minutes thereafter
OnBootSec=1min
OnUnitActiveSec=5min
# Alternatively: run every 5 minutes on the clock
# OnCalendar=*:0/5
Persistent=true

[Install]
WantedBy=timers.target
